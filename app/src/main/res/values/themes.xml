<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Settings app: Material 3 in Nord Light by day; values-night switches to Nord Dark. -->
    <style name="Theme.Continuum" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/nord10</item>
        <item name="colorOnPrimary">@color/nord6</item>
        <item name="colorPrimaryContainer">@color/nord4</item>
        <item name="colorOnPrimaryContainer">@color/nord0</item>
        <item name="colorSecondaryContainer">@color/nord4</item>
        <item name="colorOnSecondaryContainer">@color/nord0</item>
        <item name="colorAccent">@color/nord10</item>
        <item name="android:colorBackground">@color/nord6</item>
        <item name="colorSurface">@color/nord6</item>
        <item name="colorOnSurface">@color/nord0</item>
        <item name="colorOnSurfaceVariant">@color/nord3</item>
        <item name="colorSurfaceContainerLow">@color/nord5</item>
        <item name="colorSurfaceContainer">@color/nord5</item>
        <item name="colorSurfaceContainerHigh">@color/nord5</item>
        <item name="colorSurfaceContainerHighest">@color/nord4</item>
        <item name="colorOutline">@color/nord_line_light</item>
        <item name="colorOutlineVariant">@color/nord_line_light</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="preferenceTheme">@style/PreferenceTheme.Continuum</item>
    </style>
</resources>
