        <item name="switchPreferenceCompatStyle">@style/Preference.Switch.Continuum</item>
    </style>

    <style name="Preference.Switch.Continuum" parent="Preference.SwitchPreferenceCompat.Material">
        <item name="widgetLayout">@layout/pref_switch</item>
    </style>
</resources>
