<?xml version="1.0" encoding="utf-8"?>
<!-- Theme, layout and the visiting animals. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <ListPreference
        app:defaultValue="chameleon"
        app:entries="@array/theme_names"
        app:entryValues="@array/theme_values"
        app:key="theme"
        app:title="@string/pref_theme"
        app:useSimpleSummaryProvider="true" />
    <ListPreference
        app:defaultValue="qwertz"
        app:entries="@array/layout_names"
        app:entryValues="@array/layout_values"
        app:key="layout"
        app:title="@string/pref_layout"
        app:useSimpleSummaryProvider="true" />
    <SwitchPreferenceCompat
        app:defaultValue="true"
        app:key="animals"
        app:summary="@string/pref_animals_summary"
        app:title="@string/pref_animals" />
    <MultiSelectListPreference
        app:defaultValue="@array/animal_values"
        app:dependency="animals"
        app:entries="@array/animal_names"
        app:entryValues="@array/animal_values"
        app:key="animal_kinds"
        app:title="@string/pref_animal_kinds" />
</PreferenceScreen>
