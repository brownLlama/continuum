<?xml version="1.0" encoding="utf-8"?>
<!-- Corrections, feedback, the clipboard history and learned words. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <SwitchPreferenceCompat
        app:defaultValue="false"
        app:key="autocorrect"
        app:summary="@string/pref_autocorrect_summary"
        app:title="@string/pref_autocorrect" />
    <SwitchPreferenceCompat
        app:defaultValue="false"
        app:key="autocaps"
        app:title="@string/pref_autocaps" />
    <SeekBarPreference
        android:max="170"
        app:defaultValue="110"
        app:key="hold_ms"
        app:min="50"
        app:seekBarIncrement="10"
        app:showSeekBarValue="true"
        app:summary="@string/pref_hold_ms_summary"
        app:title="@string/pref_hold_ms"
        app:updatesContinuously="true" />
    <PreferenceCategory app:title="@string/cat_vibration">
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="vibrate_keys"
            app:summary="@string/pref_vibrate_summary"
            app:title="@string/pref_vibrate" />
        <SeekBarPreference
            android:max="100"
            app:defaultValue="55"
            app:dependency="vibrate_keys"
            app:key="vibrate_strength"
            app:min="10"
            app:seekBarIncrement="5"
            app:showSeekBarValue="true"
            app:summary="@string/pref_vibrate_strength_summary"
            app:title="@string/pref_vibrate_strength"
            app:updatesContinuously="true" />
    </PreferenceCategory>
    <PreferenceCategory app:title="@string/cat_clipboard">
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="clipboard_history"
            app:summary="@string/pref_clipboard_summary"
            app:title="@string/pref_clipboard" />
        <ListPreference
            app:defaultValue="168"
            app:dependency="clipboard_history"
            app:entries="@array/clipboard_keep_names"
            app:entryValues="@array/clipboard_keep_values"
            app:key="clipboard_keep_hours"
            app:title="@string/pref_clipboard_keep"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>
    <PreferenceCategory app:title="@string/cat_learned">
        <Preference
            app:icon="@drawable/ic_delete"
            app:key="clear_learned_action"
            app:summary="@string/pref_clear_summary"
            app:title="@string/pref_clear" />
    </PreferenceCategory>
</PreferenceScreen>
