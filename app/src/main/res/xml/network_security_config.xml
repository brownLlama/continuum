<?xml version="1.0" encoding="utf-8"?>
<!-- Encrypted connections only, trusting only the system's certificate authorities (not user-added ones). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
